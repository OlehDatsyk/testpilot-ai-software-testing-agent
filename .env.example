# TestPilot AI — environment configuration
# Copy to `.env` (the startup scripts do this for you) and adjust.
# NEVER commit `.env`. Values below are safe placeholders.

# --- Core (required in production) -------------------------------------------------
ENVIRONMENT=development                 # development | test | production
# Required in production: a random string of 32+ characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional separate Fernet key for encrypting stored GitHub tokens (defaults to a key derived from SECRET_KEY).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=INFO

# Database. Default (empty) = SQLite file at backend/data/testpilot.db.
# Production: postgresql://user:password@host:5432/dbname (postgres:// URLs are accepted too)
DATABASE_URL=
# SQLite only: create tables on start-up. Production uses `alembic upgrade head`.
AUTO_CREATE_TABLES=true

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------------------
# Snapshots, run logs and generated reports. Default: backend/data/storage
STORAGE_ROOT=
MAX_REPOSITORY_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=200
DEMO_MODE_ENABLED=true

# --- GitHub (optional) ------------------------------------------------------------------
# Public repositories work without any of these.
# OAuth App callback must be: <backend-url>/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback
# Optional token used only to raise rate limits for public-repository imports.
GITHUB_PUBLIC_TOKEN=

# --- AI provider (optional) ------------------------------------------------------------
# none | anthropic. Everything works without AI (rule-based generation, grounded assistant).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_REQUESTS_PER_HOUR=60

# --- Test execution -----------------------------------------------------------------------
# disabled      : no code is executed (default, safe everywhere)
# docker        : isolated container per job (requires Docker + runner image, see EXECUTION_SECURITY.md)
# local_trusted : development only, bundled demo project only, NO isolation
EXECUTION_PROVIDER=disabled
EXECUTION_TIMEOUT=120
EXECUTION_MEMORY_MB=512
EXECUTION_CPUS=1.0
EXECUTION_PIDS_LIMIT=128
EXECUTION_IMAGE=testpilot-runner:latest
ALLOW_LOCAL_TRUSTED_EXECUTION=false

# --- Frontend (build-time, PUBLIC — never put secrets in VITE_ variables) ----------------
VITE_API_BASE_URL=http://localhost:8000
